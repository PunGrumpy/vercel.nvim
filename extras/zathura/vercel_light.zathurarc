# Vercel color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers
#
# Vercel color theme
#
set notification-error-bg "#d22a38"
set notification-error-fg "#515151"
set notification-warning-bg "#946300"
set notification-warning-fg "#676767"
set notification-bg "#ffffff"
set notification-fg "#515151"
set completion-bg "#ffffff"
set completion-fg "#808080"
set completion-group-bg "#ffffff"
set completion-group-fg "#808080"
set completion-highlight-bg "#676767"
set completion-highlight-fg "#515151"
set index-bg "#ffffff"
set index-fg "#515151"
set index-active-bg "#676767"
set index-active-fg "#515151"
set inputbar-bg "#ffffff"
set inputbar-fg "#515151"
set statusbar-bg "#ffffff"
set statusbar-fg "#515151"
set highlight-color "#946300"
set highlight-active-color "#009f35"
set default-bg "#ffffff"
set default-fg "#515151"
set render-loading true
set render-loading-fg "#ffffff"
set render-loading-bg "#515151"
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#515151"
