# Vercel color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers
#
# Vercel color theme
#
set notification-error-bg "#d8001b"
set notification-error-fg "#171717"
set notification-warning-bg "#ffae00"
set notification-warning-fg "#a8a8a8"
set notification-bg "#ffffff"
set notification-fg "#171717"
set completion-bg "#ffffff"
set completion-fg "#4d4d4d"
set completion-group-bg "#ffffff"
set completion-group-fg "#4d4d4d"
set completion-highlight-bg "#a8a8a8"
set completion-highlight-fg "#171717"
set index-bg "#ffffff"
set index-fg "#171717"
set index-active-bg "#a8a8a8"
set index-active-fg "#171717"
set inputbar-bg "#ffffff"
set inputbar-fg "#171717"
set statusbar-bg "#ffffff"
set statusbar-fg "#171717"
set highlight-color "#ffae00"
set highlight-active-color "#107d32"
set default-bg "#ffffff"
set default-fg "#171717"
set render-loading true
set render-loading-fg "#ffffff"
set render-loading-bg "#171717"
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#ffffff"
set recolor-darkcolor "#171717"
