[delta]
  minus-style                   = syntax "#febfcd"
  minus-non-emph-style          = syntax "#febfcd"
  minus-emph-style              = syntax "#fe8ca4"
  minus-empty-line-marker-style = syntax "#febfcd"
  line-numbers-minus-style      = "#d8001b"
  plus-style                    = syntax "#c9ead1"
  plus-non-emph-style           = syntax "#c9ead1"
  plus-emph-style               = syntax "#9ed8ad"
  plus-empty-line-marker-style  = syntax "#c9ead1"
  line-numbers-plus-style       = "#107d32"
  line-numbers-zero-style       = "#eaeaea"
