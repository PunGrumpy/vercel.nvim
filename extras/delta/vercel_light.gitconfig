[delta]
  minus-style                   = syntax "#f4cacd"
  minus-non-emph-style          = syntax "#f4cacd"
  minus-emph-style              = syntax "#eb9fa5"
  minus-empty-line-marker-style = syntax "#f4cacd"
  line-numbers-minus-style      = "#e62f00"
  plus-style                    = syntax "#bfe7cd"
