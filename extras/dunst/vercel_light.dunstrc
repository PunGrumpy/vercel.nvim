# Vercel colors for dunst
# For more configuration options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#fafafa"
    foreground = "#171717"
    frame_color = "#171717"

[urgency_normal]
    background = "#ffffff"
    foreground = "#171717"
    frame_color = "#171717"

[urgency_critical]
    background = "#f2f2f2"
    foreground = "#fc0035"
    frame_color = "#fc0035"
